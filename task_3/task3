from abc import ABC, abstractmethod
from enum import Enum

class ItemStatus(Enum):
    AVAILABLE = "AVAILABLE"
    CHECKED_OUT = "CHECKED_OUT"
    LOST = "LOST"

#----------------libraryitem----------------
class LibraryItem(ABC):
    def __init__(self ,status):
        self._status = ItemStatus(status)
    @property
    def status(self):
        return self._status

    def checkout(self):
        if self._status == ItemStatus.AVAILABLE:
            self._status = ItemStatus.CHECKED_OUT
        else:
            print("ERORR")  

    def return_item(self):
        if self._status == ItemStatus.CHECKED_OUT:
            self._status = ItemStatus.AVAILABLE
        else:
            print("ERROR")

    def mark_lost(self):
        if self._status == ItemStatus.AVAILABLE or self._status == ItemStatus.CHECKED_OUT:
            self._status = ItemStatus.LOST
        else:
            print("ERORR")    

    def __lt__(self ,other):
        return self.title < other.title

    def __str__(self):
        return f"{self.title} ({self.type})-{self.status.value}"    

    @classmethod
    def from_dict(cls ,data):
        ItemType = data["type"]
        type_registry = {"Book":Book,"DVD":DvD,"Magazine":Magazine,"AudioBook":AudioBook}
        ItemClass = type_registry[ItemType]
        return ItemClass(**data)  #34an ngeb kol eli f el dictionary

    @abstractmethod
    def Loan_Period(self):
        pass
     
#--------------------------book---------------------------
class Book(LibraryItem):
    def __init__(self ,type:str ,title:str ,author:str ,isbn:str ,status:str):
        super().__init__(status)
        self.type = type
        self.title = title
        self.author = author
        self.isbn = isbn
    def __repr__(self):
        return f"book(type='{self.type}',title='{self.title}',author:'{self.author}',isbn='{self.isbn}',status='{self._status}')" 

    @staticmethod
    def CheckISBN(isbn:str): # ISBN-13
        if len(isbn) != 13:
            return False
        if  not isbn.isdigit():
            return False
        Total = 0
        for i in range(12):
            if i % 2 == 0:
                Total += int(isbn[i]) * 1
            else:
                Total += int(isbn[i]) * 3
        CheckDigit = (10 - (Total % 10)) % 10
        return CheckDigit == int(isbn[12])            

    def Loan_Period(self):
        return 21 
    
