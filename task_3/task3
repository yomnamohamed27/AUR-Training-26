class library:
    def __init__(self):
        self.Items = [] # empty list 
    def add_Items(self ,Item):
        self.Items.append(Item)

    def checkout(self ,Item):
        if Item in self.Items:
            Item.checkout()

    def return_item(self ,Item):
        if Item in self.Items:
            Item.return_item()

    def find_by_title(self ,title):
        for Item in self.Items:
            if Item.title == title:
                return Item
        print("NOT FOUND")
        return None  

    def list_available(self):
        availableItems = [] #empty list
        for Item in self.Items:
            if Item.status == ItemStatus.AVAILABLE:
                availableItems.append(Item)
        return availableItems           

#-------------------database--------------------------
class Database:
    def __init__(self):
        self.file = "database.txt"

    def save_items(self ,data):
        with open(self.file,"w") as file: #write fel file
            for Item in data:
                if isinstance(Item,Book):
                    file.write(f"type={Item.type}|title={Item.title}|author={Item.author}|isbn={Item.isbn}|status={Item.status.value}\n")
                elif isinstance(Item,DvD):
                    file.write(f"type={Item.type}|title={Item.title}|director={Item.director}|status={Item.status.value}\n")   
                elif isinstance(Item,Magazine):
                    file.write(f"type={Item.type}|title={Item.title}|issue={Item.issue}|status={Item.status.value}\n")

    def load_items(self):
        loaded = [] #empty list
        with open(self.file,"r") as file: #read mn el file
            for Item in file:
                Data = {} #empty dictionary
                items = Item.strip().split("|")    
                for i in items:
                    key ,value = i.split("=")
                    Data[key] = value
                item = LibraryItem.from_dict(Data)
                loaded.append(item)

        return loaded        

